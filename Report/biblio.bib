@inproceedings{fernandes_blocks_2026,
    title = {Blocks or {Text}: {Who} {Struggles}, {Who} {Thrives}?},
    
    doi = {10.1145/3770762.3772532},
    abstract = {Programming, its status in education, and how its fundamental concepts can be taught to an inexperienced audience are among the oldest debates in the field of computer science education. While there is consensus about programming being a crucial skill to acquire, there is much less consensus about which programming paradigm to use. Popular paradigms include both block-based and text-based programming. We examine whether the choice of paradigm impacts the learners’ conceptual understanding, whether typing proficiency should play a role when selecting the programming paradigm, and whether there are significant differences in task completion time and the number of logical mistakes made. More than 350 children participated in our study and learned to program with turtle graphics in either a text-based or block-based learning environment. We found that both text- and block-based programming improve students’ conceptual understanding significantly. Furthermore, we found block-based programming to simultaneously increase the number of logical mistakes while also significantly reducing the time spent per task. In contrast, typing proficiency plays no significant role in task completion time. The choice of a paradigm for beginners is strongly debated—this work helps to provide new perspectives in the discussion. © 2026 Copyright held by the owner/author(s).},
    booktitle = {{SIGCSE} {TS} 2026 - {Proceedings} of the 57th {ACM} {Technical} {Symposium} on {Computer} {Science} {Education} {V}.1},
    author = {Fernandes, Rafael and Wiß, Alexander and Schneider, Andreas and Loyo, Angélica Herrera and Komm, Dennis and Staub, Jacqueline},
    year = {2026},
    keywords = {Block based, Blockbased vs., Computer aided instruction, Computer Science Education, Conceptual understanding, Education computing, Engineering education, Fundamental concepts, Programming education, Programming paradigms, Task completion time, Text-based, Turtle graphics},
    pages = {316 -- 322},
    annote = {Cited by: 0; All Open Access, Gold Open Access},
    file = {Blocks or Text Who Struggles Who Thrives.pdf:files/41/Blocks or Text Who Struggles Who Thrives.pdf:application/pdf},
}

